# Copy to apps/web/.env.local (git-ignored) and fill in real local values.
# Next.js loads apps/web/.env.local for `next dev` and `next build` — it does
# NOT read the repository root .env (compose/seed own that one).

# REST edge (ADR-0001). The BFF proxies auth and business calls here.
GATEWAY_URL=http://localhost:8080

# Demo tenant switcher entries: "slug=email" pairs. Each email must be a
# DISTINCT tenant admin (created via cmd/useradmin — see "Demo tenant admins"
# in docs/onboarding.md): identity logins fail with a generic 401 when one
# email matches users in several tenants.
DEMO_TENANTS=acme=admin@acme.example,glow=admin@glow.example

# Shared password of the demo tenant admins above. Empty disables the
# automatic switch (the UI falls back to /login prefilled with the email).
# Placeholder only — set the real value in apps/web/.env.local, never commit.
#DEMO_ADMIN_PASSWORD=

# NOTE on gateway login rate limiting (GATEWAY_LOGIN_RATE_PER_MIN, root
# .env.example): all web traffic reaches the gateway through this BFF, so the
# gateway sees the BFF's IP — the per-IP bucket is effectively per BFF
# instance in the local demo. Identity's per-email limiter (5/min) stays as
# defense in depth, which also means rapid tenant switching can surface a
# brief 429; wait a minute and retry. X-Forwarded-For parsing is a follow-up
# if the gateway is ever exposed directly.
