# Local-only defaults. Copy to .env — never commit .env.

# Ports
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
IDENTITY_PORT=8081
PROCUREMENT_PORT=8082
DOCUMENTS_PORT=8083
GATEWAY_PORT=8080

# Credentials (local development only)
POSTGRES_USER=eprocurement
POSTGRES_PASSWORD=eprocurement
POSTGRES_DB=eprocurement
MONGO_ROOT_USER=eprocurement
MONGO_ROOT_PASSWORD=eprocurement
MONGO_DB=eprocurement
RABBITMQ_USER=eprocurement
RABBITMQ_PASSWORD=eprocurement
MINIO_ROOT_USER=eprocurement
MINIO_ROOT_PASSWORD=eprocurement

# Connection strings used by services
DATABASE_URL=postgres://eprocurement:eprocurement@localhost:5432/eprocurement?sslmode=disable
MONGO_URI=mongodb://eprocurement:eprocurement@localhost:27017/eprocurement?authSource=admin
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://eprocurement:eprocurement@localhost:5672/
# documents service talks to MinIO directly: host:port, no scheme (S3_USE_SSL switches to TLS)
S3_ENDPOINT=localhost:9000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Application services (optional; defaults shown)
APP_ENV=local
LOG_LEVEL=info

# identity service
IDENTITY_LOGIN_RATE_PER_MIN=5
# Stable signing key across restarts: base64 of a 32-byte Ed25519 seed.
# Generate: openssl rand -base64 32. Empty = ephemeral key per boot.
#IDENTITY_JWT_KEY=
# Previous signing key during rotation (see docs/ops/jwks-rotation.md).
#IDENTITY_JWT_KEY_PREVIOUS=

# gateway service
IDENTITY_ADDR=localhost:8081
PROCUREMENT_ADDR=localhost:8082
DOCUMENTS_ADDR=localhost:8083
JWKS_CACHE_TTL=5m
# Public login throttle: requests per client IP per minute. All web traffic
# reaches the gateway through the apps/web BFF, so this bucket is effectively
# per BFF instance locally; identity's 5/min per-email limiter remains as
# defense in depth.
GATEWAY_LOGIN_RATE_PER_MIN=30

# web app (apps/web) — Next.js reads apps/web/.env.local (NOT this file) for
# GATEWAY_URL, DEMO_TENANTS, and DEMO_ADMIN_PASSWORD; placeholders live in
# apps/web/.env.example.

# worker service. Poll interval and batch size are the PRD §16 pins (2s / 50);
# the overrides below exist for tests and local tuning — compose does not set
# them. DLQ_SUMMARY_INTERVAL is the #48 DLQ monitor cadence (PRD §16 "hourly
# summary metric": one structured depth log per interval). RABBITMQ_URL above
# is the broker the publisher dials AND, since #48, the gateway's DLQ admin
# endpoint (compose passes the same value to both services).
#WORKER_POLL_INTERVAL=2s
#WORKER_BATCH_SIZE=50
#WORKER_CONFIRM_TIMEOUT=5s
#DLQ_SUMMARY_INTERVAL=1h
# Nightly export scheduler (#49). Single env-level schedule: HH:MM in an
# IANA zone (the worker embeds time/tzdata, so any zone name works inside
# the alpine container). The lock TTL MUST strictly exceed the job budget —
# the worker refuses to boot otherwise (no silent overlap). The CSV writer
# uses the SAME S3_BUCKET as documents (one bucket, exports/ prefix);
# REDIS_URL above is the lock + heartbeat store.
#EXPORT_SCHEDULE=01:00
#EXPORT_TZ=UTC
#EXPORT_LOCK_TTL=15m
#EXPORT_JOB_BUDGET=10m

# documents service
S3_ACCESS_KEY=eprocurement
S3_SECRET_KEY=eprocurement
S3_BUCKET=attachments
S3_USE_SSL=false
# Host minted into presigned URLs when it differs from S3_ENDPOINT (compose
# services dial minio:9000 internally; clients outside need localhost:9000).
S3_PRESIGN_ENDPOINT=localhost:9000
ATTACHMENT_MAX_SIZE_MB=25
# Pending uploads older than this TTL are removed by the reaper job.
ATTACHMENT_PENDING_TTL=24h
# Orphan-upload sweep interval; 0 disables the job.
REAPER_INTERVAL=30m
